{
  "uid": "github-api-gateway-overview",
  "title": "GitHub API Gateway Overview",
  "tags": ["github-api-gateway", "prometheus", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "expr": "github_api_gateway_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Configured Tokens",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "github_api_gateway_tokens_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Policy Rules",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "github_api_gateway_policy_rules",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "ETag Cache Entries",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "github_api_gateway_cache_entries",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active Client Rate-Limit Buckets",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "github_api_gateway_ratelimit_active_buckets",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Active Auth Keys",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "github_api_gateway_active_auth_keys",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "GitHub Token Pool Remaining Quota (per Masked Token)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "github_api_gateway_token_remaining",
          "legendFormat": "{{token_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "HTTP Request Rate by Status (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "expr": "rate(github_api_gateway_requests_total[1m])",
          "legendFormat": "{{method}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Request Latency Percentiles (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(github_api_gateway_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(github_api_gateway_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "ETag Cache Outcomes & Policy / Rate-Limit Decisions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "github_api_gateway_cache_events_total",
          "legendFormat": "cache: {{result}}",
          "refId": "A"
        },
        {
          "expr": "github_api_gateway_policy_decisions_total",
          "legendFormat": "policy: {{decision}}",
          "refId": "B"
        },
        {
          "expr": "github_api_gateway_ratelimit_decisions_total",
          "legendFormat": "ratelimit: {{decision}}",
          "refId": "C"
        }
      ]
    }
  ]
}
