# GitHub API Gateway Configuration
# All environment variables use the conflict-free GITHUB_API_GATEWAY_ prefix

# Comma-separated list of GitHub tokens (Classic, Fine-grained, OAuth, App)
# YOU CAN KEEP ONLY THIS LINE IN YOUR LOCAL .env FILE:
GITHUB_API_GATEWAY_TOKENS=ghp_exampleToken1,ghp_exampleToken2

# Optional overrides (default values shown below):
# GITHUB_API_GATEWAY_PORT=8080
# GITHUB_API_GATEWAY_AUTH_KEYS=key-for-ci-runners,key-for-dev-team
# GITHUB_API_GATEWAY_POLICY_PATH=policy.yaml
# GITHUB_API_GATEWAY_TOKEN_MIN_REMAINING=3000
# GITHUB_API_GATEWAY_FALLBACK_UNAUTHENTICATED=true
# GITHUB_API_GATEWAY_CACHE_TTL_SECONDS=300
# GITHUB_API_GATEWAY_TARGET_URL=https://api.github.com
