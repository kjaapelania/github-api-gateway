# GitHub API Relay Configuration

# Port to bind locally
PORT=8080

# Comma-separated list of GitHub tokens (Classic, Fine-grained, OAuth, App)
GITHUB_TOKENS=ghp_exampleToken1,ghp_exampleToken2

# Comma-separated list of pre-shared keys required to access this relay (optional)
RELAY_AUTH_KEYS=key-for-ci-runners,key-for-dev-team

# Path to the granular enterprise policy file
POLICY_PATH=policy.yaml

# Minimum remaining calls buffer before rotating (default: 3000 to protect colleague quota)
TOKEN_MIN_REMAINING=3000

# Fallback to unauthenticated IP requests when tokens are exhausted (true/false)
FALLBACK_UNAUTHENTICATED=true

# In-memory ETag cache TTL in seconds
CACHE_TTL_SECONDS=300
